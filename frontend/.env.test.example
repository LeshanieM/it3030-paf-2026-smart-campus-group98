## Playwright E2E test configuration
## Copy to `.env.test` (do not commit `.env.test`) and fill in values.

# Backend JWT signing secret (HS256) used by tests to mint a token.
TEST_JWT_SECRET=change-me

# Test user identity (must exist/be accepted by your backend auth logic)
TEST_USER_EMAIL=user@example.com
TEST_USER_ID=change-me
TEST_USER_NAME=Test User
TEST_USER_ROLE=USER

